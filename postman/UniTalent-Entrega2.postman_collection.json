      "url":{"raw":"{{baseUrl}}/api/estudantes","host":["{{baseUrl}}"],"path":["api","estudantes"]}}
    },
    {
      "name":"4 - Criar empresa",
      "request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer COLE_SEU_TOKEN"}],
      "body":{"mode":"raw","raw":"{\"razaoSocial\":\"Empresa Tech Ltda\",\"cnpj\":\"00.000.000/0001-00\",\"email\":\"rh@empresa.com\",\"descricao\":\"Empresa de tecnologia\"}"},
      "url":{"raw":"{{baseUrl}}/api/empresas","host":["{{baseUrl}}"],"path":["api","empresas"]}}
    },
    {
      "name":"5 - Criar vaga",
      "request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer COLE_SEU_TOKEN"}],
      "body":{"mode":"raw","raw":"{\"titulo\":\"Estágio em Desenvolvimento Java\",\"descricao\":\"Desenvolvimento de APIs\",\"requisitos\":\"Java, Spring Boot\",\"empresaId\":1,\"status\":\"ATIVA\"}"},
      "url":{"raw":"{{baseUrl}}/api/vagas","host":["{{baseUrl}}"],"path":["api","vagas"]}}
    },
    {
