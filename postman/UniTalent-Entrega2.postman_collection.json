  "item": [
    {
      "name":"1 - Registrar usuário",
      "request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],
      "body":{"mode":"raw","raw":"{\"username\":\"admin\",\"password\":\"123456\",\"role\":\"ADMIN\"}"},
      "url":{"raw":"{{baseUrl}}/api/auth/register","host":["{{baseUrl}}"],"path":["api","auth","register"]}}
    },
    {
      "name":"2 - Login",
      "request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],
      "body":{"mode":"raw","raw":"{\"username\":\"admin\",\"password\":\"123456\"}"},
      "url":{"raw":"{{baseUrl}}/api/auth/login","host":["{{baseUrl}}"],"path":["api","auth","login"]}}
    },
    {
      "name":"3 - Criar estudante",
